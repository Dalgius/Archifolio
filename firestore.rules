rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // UID dell'utente admin
    // (Firebase Console → Authentication → Users → colonna "User UID").
    function isAdmin() {
      return request.auth != null && request.auth.uid in ['OW6fJtKBdsThgiJviCRC3Cijj8o2'];
    }

    match /projects/{projectId} {
      // I visitatori leggono solo i progetti pubblici; l'admin legge tutto.
      allow read: if resource.data.isPublic == true || isAdmin();
      // Solo l'admin può creare, modificare ed eliminare.
      allow write: if isAdmin();
    }
  }
}
